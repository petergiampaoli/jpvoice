# By default jpvoice reads your existing OpenCode Go credentials from
# ~/.local/share/opencode/auth.json. You do not need to put a key here.
#
# Optional overrides:
# OPENCODE_API_KEY=oc_...
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Direct DeepSeek instead of the OpenCode gateway:
# JPVOICE_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# Models
# JPVOICE_MODEL_FLASH=deepseek-v4.1-flash
# JPVOICE_MODEL_PRO=deepseek-v4-pro

# Reasoning budget: none | low | medium | high | max
# `none` is correct for drafting and line-editing. Reasoning tokens are not
# bounded by max_tokens on every model, and an unbounded default can turn one
# scene into a five-minute request.
# JPVOICE_EFFORT_FLASH=none
# JPVOICE_EFFORT_PRO=none

# "flash" is the default: it is ~25x cheaper than Pro and scored better on the
# line-editing A/B. Set to "pro" to use DeepSeek V4 Pro for revision.
# JPVOICE_TIER_POLISH=flash

# JPVOICE_TIMEOUT_MS=240000

# Run the full pipeline without a key (deterministic canned output).
# JPVOICE_MOCK=1
